<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <DUT Name="ST_SystemClimatizedRoomChillerState" Id="{48e0cba5-b086-4590-99b5-594598371795}">
    <Declaration><![CDATA[{attribute 'OPC.UA.DA.StructuredType' := '1'}
TYPE ST_SystemClimatizedRoomChillerState :
STRUCT
	//general information
	bOperational				: BOOL;
	bErrorVentilator 			: BOOL;
	bErrorCompressor 			: BOOL;
	bErrorPump 					: BOOL;
	bErrorOverheatingControler 	: BOOL;
	
	//controler states
	bIR33ControlMode			: BOOL; // current control mode (0= proportional, 1= PID-control)
	nIR33OperatingMode			: INT; // current operating mode (1= Direct, 2= Reverse, 3= Neutralzone, 4= PWM, 5= Alarm, 6= Direct/Reverse over DI1, 7= Direct/Direct over DI1, 8= Reverse/Reverse over DI1, 9= Direct/Reverse with different set points)
	fIR33CurrentSetpointTemperature	: REAL; // Read setpoint temperature from controller
	bTemperatureUnit			: BOOL; // 0= °C, 1= °F
	
	//temperature sensors
	fTempSensorIR33		 		: REAL; //°C
	fTempCondenserAirIn 		: REAL; //°C
	fTempCondenserAirOut 		: REAL; //°C
	fTempCondenserMediumIn 		: REAL; //°C
	fTempCondenserMediumOut 	: REAL; //°C
	fTempCompressorSuctionLine 	: REAL; //°C
	fTempMediumIn 				: REAL; //°C
	fTempMediumOut 				: REAL; //°C
	
	//pressure sensors
	fPressureCondenserMediumOut 	: REAL; //bar
	fPressureCompressorSuctionLine 	: REAL; //bar
	
	//flow rate sensor
	fFlowRateMediumIn : REAL; //l/min
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>