<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <DUT Name="ST_PumpGrundfosMagna3State" Id="{2e0e0d05-2e8a-40b3-8fdf-0cb5e297c45b}">
    <Declaration><![CDATA[{attribute 'OPC.UA.DA.StructuredType' := '1'}
TYPE ST_PumpGrundfosMagna3State :
STRUCT
	bRemoteControlOn : BOOL; //0 = control by pump, 1 = control by bus 
	fVolumeFlowRate : REAL; //m^3/h volume flow rate from pump or external sensor
	fTemperatureInternal : REAL; //°C
	fTemperatureExternal : REAL; //°C
	fTemperatureDifference : REAL; //°C
	fPressureDifference : REAL; //pa = 10^-5 bar
	fPowerElectric : REAL; //W
	fPowerHydraulic : REAL; //W
	fPowerThermal : REAL; //W
	fRotationalSpeed : REAL; //rpm
	nLiquid : E_Liquids; //liquid used in the pump (water, glycol)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>