      <LineId Id="97" Count="0" />
      <LineId Id="75" Count="3" />
      <LineId Id="98" Count="0" />
      <LineId Id="82" Count="0" />
      <LineId Id="99" Count="0" />
      <LineId Id="89" Count="5" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>