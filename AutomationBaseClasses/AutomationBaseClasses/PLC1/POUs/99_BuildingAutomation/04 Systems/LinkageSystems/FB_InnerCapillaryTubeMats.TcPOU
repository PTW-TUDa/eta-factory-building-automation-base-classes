      </Implementation>
    </Method>
    <Method Name="RampDown" Id="{a3bbb3df-240d-4274-b5c7-44e29ede78a1}">
      <Declaration><![CDATA[METHOD PROTECTED  RampDown : BOOL
VAR_INPUT
END_VAR
VAR_OUTPUT
